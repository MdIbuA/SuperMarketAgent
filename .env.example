# Nebula Supermarket Ops Agent - Environment Variables

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Anthropic API Key
ANTHROPIC_API_KEY=

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supermarket_agent

# Claude Model
CLAUDE_MODEL=claude-sonnet-4-20250514

# Log Level
LOG_LEVEL=info

# Node Environment
NODE_ENV=development
