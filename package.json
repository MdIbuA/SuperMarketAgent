{
  "name": "supermarket-ops-agent",
  "version": "1.0.0",
  "description": "AI-operated Indian kirana/supermarket controlled via Telegram",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^6.9.0",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.5.0",
    "grammy": "^1.35.0",
    "pdfkit": "^0.16.0",
    "pptxgenjs": "^3.12.0",
    "typescript": "^5.8.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.0",
    "vitest": "^3.2.0"
  }
}
